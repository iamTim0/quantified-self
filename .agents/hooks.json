{
  "safety-guardrail": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/scripts/pre_command_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "doc-validator": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python .agents/scripts/validate_docs.py",
        "timeout": 15
      }
    ]
  }
}
