# The importer publish phase and the Core loading phase are distinct.
#
# The importer may finish publishing before Core has consumed every event. A run
# can therefore become successful only after the Core-side processed count reaches
# the published count.

MAX_POINTS = 2


action Init:
    run_status = "running"
    published_points = 0
    processed_points = 0


atomic action ImporterPublish:
    require run_status == "running"
    require published_points < MAX_POINTS
    published_points = published_points + 1
    if published_points == MAX_POINTS:
        run_status = "loading"


atomic action CoreProcess:
    require run_status == "loading"
    require processed_points < published_points
    processed_points = processed_points + 1
    if processed_points == published_points:
        run_status = "success"


always assertion ImportCompletionAfterCoreProcessing:
    # Success is only reachable after Core has drained the published events.
    return run_status != "success" or processed_points == published_points


always assertion LoadingPhaseIsVisible:
    # A full publish with work still outstanding must remain visibly in loading.
    return run_status != "loading" or published_points == MAX_POINTS
