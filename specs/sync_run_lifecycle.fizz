# The importer publish phase and the Core loading phase are distinct.
#
# The importer may finish publishing before Core has consumed every event. A run
# can therefore become successful only after the Core-side processed count reaches
# the published count.

MAX_POINTS = 2


action Init:
    run_status = "running"
    published_event_keys = []
    processed_event_keys = []
    processed_points = 0


atomic action ImporterPublish:
    require run_status == "running"
    require len(published_event_keys) < MAX_POINTS
    event_key = "event_" + str(len(published_event_keys) + 1)
    published_event_keys.append(event_key)
    if len(published_event_keys) == MAX_POINTS:
        run_status = "loading"


atomic action CoreProcess:
    require run_status == "loading"
    event_key = oneof(published_event_keys)
    if event_key not in processed_event_keys:
        processed_event_keys.append(event_key)
        processed_points = processed_points + 1
    if processed_points == len(published_event_keys):
        run_status = "success"


always assertion ImportCompletionAfterCoreProcessing:
    # Success is only reachable after Core has drained the published events.
    return run_status != "success" or processed_points == len(published_event_keys)


always assertion SyncRunProgressAtMostOnce:
    # A redelivered broker event may be observed again, but it cannot advance the
    # durable processed count a second time.
    return processed_points == len(processed_event_keys)


always assertion LoadingPhaseIsVisible:
    # A full publish with work still outstanding must remain visibly in loading.
    return run_status != "loading" or len(published_event_keys) == MAX_POINTS
