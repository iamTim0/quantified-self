# Fizzbee Formal Specification: Connector Credentials & Secret Encryption
# Models multi-tenant connector configuration, AES encryption at rest, secret masking on
# read, and tenant isolation -- now with several instances of the same connector type in
# one workspace, which is what the schema allows since migration 009.

TENANTS = ["tenant_a", "tenant_b"]
# Two types are enough to show that a name is unique *per type*, and the calendar is the
# case that motivated the change: one workspace, several feeds.
CONNECTORS = ["oura", "calendar"]
# What the user calls an instance. Two calendars are indistinguishable without it, which
# is why the name is required rather than derived.
NAMES = ["home", "cabin"]

# A source id is opaque -- a UUID in the implementation -- and encodes neither the tenant
# nor the type. This spec used to model it as tenant_id + ":" + source_type, which
# silently assumed one instance per type and turned TenantSecretIsolation into a claim
# about string prefixes. Isolation does not come from the shape of the id; it comes from
# tenant_id sitting in every WHERE clause, and no invariant below parses an id.
#
# The ids are a fixed table rather than a counter so that creating the same connectors in
# a different order reaches the same state. A counter makes order visible, which the model
# checker then has to explore -- that alone was enough to push this spec past its timeout.
SOURCE_IDS = {
    "tenant_a:oura:home": "src_1",
    "tenant_a:oura:cabin": "src_2",
    "tenant_a:calendar:home": "src_3",
    "tenant_a:calendar:cabin": "src_4",
    "tenant_b:oura:home": "src_5",
    "tenant_b:oura:cabin": "src_6",
    "tenant_b:calendar:home": "src_7",
    "tenant_b:calendar:cabin": "src_8"
}

# State


action Init:
    # source_id -> {tenant_id, source_type, display_name, encrypted_secret, is_encrypted}
    connector_storage = {}
    # Rows a workspace was handed that belong to somebody else. Counting the violation
    # keeps the state finite where storing every response would not.
    rows_served_to_wrong_tenant = 0

atomic action CreateOrUpdateConnector:
    tenant_id = oneof(TENANTS)
    source_type = oneof(CONNECTORS)
    display_name = oneof(NAMES)
    plaintext_secret = "raw_api_token_12345"

    # Same workspace, same type, same name -> the same row. That is the unique constraint
    # doing its work: configuring a connector twice updates it, it does not fork it.
    source_id = SOURCE_IDS[tenant_id + ":" + source_type + ":" + display_name]

    # Encrypt before persisting
    encrypted_secret = "ENC[" + plaintext_secret + "]"

    connector_storage[source_id] = {
        "tenant_id": tenant_id,
        "source_type": source_type,
        "display_name": display_name,
        "encrypted_secret": encrypted_secret,
        "is_encrypted": True
    }

atomic action QueryConnectorsMasked:
    tenant_id = oneof(TENANTS)

    # Fizzbee allows exactly one loop variable, so no `.items()` unpacking.
    for sid in connector_storage:
        source = connector_storage[sid]
        if source["tenant_id"] == tenant_id:
            # Mask secret for UI display (never expose raw token)
            masked_source = {
                "source_id": sid,
                "tenant_id": source["tenant_id"],
                "source_type": source["source_type"],
                "display_name": source["display_name"],
                "masked_secret": "••••••••12345"
            }
            if masked_source["tenant_id"] != tenant_id:
                rows_served_to_wrong_tenant = rows_served_to_wrong_tenant + 1

# SAFETY INVARIANTS

always assertion SecretsAlwaysEncryptedAtRest:
    # Every record in connector_storage must be flagged is_encrypted == True and start with ENC[
    for source in connector_storage.values():
        if source["is_encrypted"] != True:
            return False
        if not source["encrypted_secret"].startswith("ENC["):
            return False
    return True

always assertion SecretMaskedInReadResponse:
    # No raw plaintext token is stored unencrypted in storage
    for source in connector_storage.values():
        if source["encrypted_secret"] == "raw_api_token_12345":
            return False
    return True

always assertion TenantSecretIsolation:
    # What a workspace is handed belongs to that workspace. With opaque ids this is the
    # only form the property can take, and it is also the one the implementation has to
    # get right: every read filters on tenant_id.
    return rows_served_to_wrong_tenant == 0

always assertion InstanceNamesUniquePerTenantType:
    # uq_data_sources_tenant_type_name. Several instances of a type are the point; two
    # with the same name are not, because the user has nothing else to tell them apart by
    # and the second configuration would read as a duplicate of the first.
    seen = []
    # Fizzbee allows exactly one loop variable, so no `.items()` unpacking.
    for sid in connector_storage:
        source = connector_storage[sid]
        key = source["tenant_id"] + ":" + source["source_type"] + ":" + source["display_name"]
        if key in seen:
            return False
        seen.append(key)
    return True
