# Fizzbee Formal Specification: Oura Importer ETL & Resiliency
# Models API polling, rate-limiting (429), token expiration (401), deterministic idempotency hashing, and NATS publishing.

TENANTS = ["tenant_a", "tenant_b"]
METRICS = ["sleep_score", "readiness_score"]

# Bounds, required for the liveness assertion at the bottom. `retry_count` is
# monotonic, so every retry produces a state never seen before and the graph
# never closes -- safety checking tolerates that, liveness does not, and the run
# exceeded its 180s budget. Two polls reach every branch the assertions read:
# a success that buffers, a 429 into backoff, a 401 into refresh, a 500 retry.
MAX_POLLS = 2



action Init:
    api_available = True
    token_valid = True
    rate_limited = False
    importer_state = "IDLE" # IDLE, POLLING, BACKOFF, REFRESHING_TOKEN
    local_buffer = []
    nats_broker = []
    published_keys = {}
    retry_count = 0
    poll_count = 0
    last_polled_timestamp = "2026-07-26T00:00:00Z"

atomic action PollOuraAPI:
    require importer_state == "IDLE" and token_valid == True and rate_limited == False
    require poll_count < MAX_POLLS
    poll_count = poll_count + 1
    importer_state = "POLLING"
    
    # Non-deterministically simulate API outcome
    outcome = oneof(["HTTP_200", "HTTP_429", "HTTP_401", "HTTP_500"])
    
    if outcome == "HTTP_200":
        tenant = oneof(TENANTS)
        metric = oneof(METRICS)
        # Create raw record
        record = {
            "tenant_id": tenant,
            "metric_type": metric,
            "timestamp": last_polled_timestamp,
            "value": 85.0
        }
        local_buffer.append(record)
        retry_count = 0
        importer_state = "IDLE"
        
    elif outcome == "HTTP_429":
        # Rate limited -> enter BACKOFF
        rate_limited = True
        retry_count = retry_count + 1
        importer_state = "BACKOFF"
        
    elif outcome == "HTTP_401":
        # Unauthorized -> require token refresh
        token_valid = False
        importer_state = "REFRESHING_TOKEN"
        
    elif outcome == "HTTP_500":
        # Server error -> retry
        retry_count = retry_count + 1
        importer_state = "IDLE"

atomic action RefreshToken:
    require importer_state == "REFRESHING_TOKEN" and token_valid == False
    # Simulate token refresh logic
    token_valid = True
    importer_state = "IDLE"

atomic action BackoffRecover:
    require importer_state == "BACKOFF" and rate_limited == True
    # Simulate backoff timer expiry
    rate_limited = False
    importer_state = "IDLE"

# Fair: the liveness property below says the buffer is eventually drained.
# An unfair action can be starved forever, which would make that false by
# construction rather than by any defect.
atomic fair action TransformAndPublish:
    require len(local_buffer) > 0
    record = local_buffer[0]
    local_buffer.pop(0)
    
    # Generate deterministic idempotency key: hash(tenant_id:source_id:metric_type:timestamp)
    key = record["tenant_id"] + ":oura_v2:" + record["metric_type"] + ":" + record["timestamp"]
    
    event = {
        "tenant_id": record["tenant_id"],
        "metric_type": record["metric_type"],
        "timestamp": record["timestamp"],
        "value": record["value"],
        "idempotency_key": key
    }
    
    nats_broker.append(event)
    published_keys[key] = event

# SAFETY INVARIANTS

always assertion IdempotencyKeyDeterministic:
    # Every published event must have a non-empty, deterministic key
    for event in nats_broker:
        if event.get("idempotency_key") == None or event.get("idempotency_key") == "":
            return False
    return True

always assertion NoDataLossOnRateLimit:
    # Being rate-limited or in backoff does not corrupt or erase local_buffer
    if rate_limited == True:
        return True
    return True

always assertion TokenRefreshEnforced:
    # Polling can never execute while token_valid is False
    if importer_state == "POLLING":
        return token_valid == True
    return True

always assertion UniqueKeyMapping:
    # In published_keys, each idempotency key maps to a unique payload structure
    # Fizzbee allows exactly one loop variable, so no `.items()` unpacking.
    for key in published_keys:
        event = published_keys[key]
        if event["idempotency_key"] != key:
            return False
    return True

# `eventually assertion` on its own is not a form Fizzbee supports -- it
# accepts always, always-eventually, eventually-always and exists, and panics
# on anything else. This claims the system settles and *stays* settled, so it
# is eventually-always.
eventually always assertion BufferFlushed:
    # If importer is idle and buffer has items, items are eventually published to NATS
    return len(local_buffer) == 0 or importer_state != "IDLE"
