{
  "$schema": "../../tools/importer-contract.schema.json",
  "contract_version": 1,
  "source_type": "calendar",
  "ingest_subject": "qs.ingest.calendar",
  "task_subject": "qs.task.sync.calendar",
  "entrypoint": "calendar_importer.main",
  "required_modules": ["client.py", "config.py", "main.py", "transformer.py"],
  "communication": {
    "ingest": "nats_jetstream",
    "credentials": "core_internal_http",
    "database_access": false,
    "request_correlation": "X-Request-ID"
  },
  "ingest_event_fields": [
    "tenant_id",
    "source_id",
    "source_type",
    "metric_type",
    "timestamp",
    "value",
    "idempotency_key"
  ],
  "input_contracts": [
    {
      "name": "iCalendar feed",
      "format": "ics",
      "source_of_truth": {
        "kind": "rfc",
        "reference": "https://www.rfc-editor.org/rfc/rfc5545"
      }
    }
  ],
  "metrics": ["calendar_busy_duration", "calendar_event_count", "calendar_meeting_duration"],
  "dynamic_namespaces": [],
  "capabilities": {
    "scheduled_sync": true,
    "webhook": false,
    "file_upload": false
  }
}
