{
  "$schema": "../../tools/importer-contract.schema.json",
  "contract_version": 1,
  "source_type": "apple_health",
  "ingest_subject": "qs.ingest.apple_health",
  "task_subject": null,
  "entrypoint": "apple_health_importer.main",
  "required_modules": ["client.py", "config.py", "main.py", "transformer.py"],
  "communication": {
    "ingest": "nats_jetstream",
    "credentials": "core_internal_http",
    "database_access": false,
    "request_correlation": "X-Request-ID"
  },
  "ingest_event_fields": [
    "tenant_id",
    "source_id",
    "source_type",
    "metric_type",
    "timestamp",
    "value",
    "idempotency_key"
  ],
  "input_contracts": [
    {
      "name": "Health Auto Export webhook JSON",
      "format": "json",
      "source_of_truth": {
        "kind": "external_documentation",
        "reference": "https://help.healthyapps.dev/en/health-auto-export/export-format/workouts"
      }
    },
    {
      "name": "Apple Health export archive",
      "format": "zip_xml_gpx",
      "source_of_truth": {
        "kind": "external_documentation",
        "reference": "https://support.apple.com/guide/iphone/share-your-health-data-iph5ede58c3d/ios"
      }
    }
  ],
  "metrics": [
    "audio_exposure_environmental",
    "audio_exposure_events",
    "audio_exposure_headphone",
    "audio_exposure_reduction",
    "blood_oxygen",
    "blood_pressure_diastolic",
    "blood_pressure_systolic",
    "body_fat",
    "body_height",
    "body_mass_index",
    "body_weight",
    "daylight_duration",
    "distance",
    "energy_active",
    "energy_resting",
    "exercise_duration",
    "flights_climbed",
    "handwashing_events",
    "heart_rate",
    "heart_rate_recovery",
    "heart_rate_resting",
    "heart_rate_walking_average",
    "hrv_sdnn",
    "lean_body_mass",
    "location_point",
    "mindful_session_duration",
    "nutrition_caffeine",
    "nutrition_calcium",
    "nutrition_carbohydrates",
    "nutrition_cholesterol",
    "nutrition_energy",
    "nutrition_fat",
    "nutrition_fat_monounsaturated",
    "nutrition_fat_polyunsaturated",
    "nutrition_fat_saturated",
    "nutrition_fiber",
    "nutrition_iron",
    "nutrition_potassium",
    "nutrition_protein",
    "nutrition_sodium",
    "nutrition_sugar",
    "nutrition_vitamin_c_intake",
    "physical_effort",
    "respiratory_rate",
    "running_ground_contact_time",
    "running_power",
    "running_speed",
    "running_stride_length",
    "running_vertical_oscillation",
    "six_minute_walk_distance",
    "sleep_duration",
    "sleep_duration_awake",
    "sleep_duration_deep",
    "sleep_duration_in_bed",
    "sleep_duration_light",
    "sleep_duration_rem",
    "stair_ascent_speed",
    "stair_descent_speed",
    "stand_duration",
    "standing_events",
    "steps",
    "swimming_strokes",
    "toothbrushing_events",
    "vo2_max",
    "walking_asymmetry",
    "walking_double_support",
    "walking_speed",
    "walking_steadiness",
    "walking_step_length",
    "water_intake",
    "workout_cadence",
    "workout_cycling_cadence",
    "workout_cycling_power",
    "workout_distance",
    "workout_duration",
    "workout_elevation_gain",
    "workout_elevation_loss",
    "workout_energy",
    "workout_energy_resting",
    "workout_heart_rate_average",
    "workout_heart_rate_max",
    "workout_intensity",
    "workout_lap_length",
    "workout_speed_average",
    "workout_speed_max",
    "workout_steps",
    "workout_swim_cadence",
    "workout_swimming_strokes"
  ],
  "dynamic_namespaces": ["apple_health_"],
  "capabilities": {
    "scheduled_sync": false,
    "webhook": true,
    "file_upload": true
  }
}
