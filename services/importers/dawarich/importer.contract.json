{
  "$schema": "../../tools/importer-contract.schema.json",
  "contract_version": 1,
  "source_type": "dawarich",
  "ingest_subject": "qs.ingest.dawarich",
  "task_subject": "qs.task.sync.dawarich",
  "entrypoint": "dawarich_importer.main",
  "required_modules": ["client.py", "config.py", "main.py", "transformer.py"],
  "communication": {
    "ingest": "nats_jetstream",
    "credentials": "core_internal_http",
    "database_access": false,
    "request_correlation": "X-Request-ID"
  },
  "ingest_event_fields": [
    "tenant_id",
    "source_id",
    "source_type",
    "metric_type",
    "timestamp",
    "value",
    "idempotency_key"
  ],
  "input_contracts": [
    {
      "name": "Dawarich location API JSON",
      "format": "rest_json",
      "source_of_truth": {
        "kind": "repository_adapter",
        "reference": "services/importers/dawarich/src/dawarich_importer/client.py"
      }
    }
  ],
  "metrics": ["location_latitude", "location_longitude", "location_point"],
  "dynamic_namespaces": [],
  "capabilities": {
    "scheduled_sync": true,
    "webhook": false,
    "file_upload": false
  }
}
