# Python
#
# The generic single-word entries below are anchored with a leading slash so they
# only match at the repository root. Unanchored, `lib/` matches a directory named
# `lib` at ANY depth -- which silently excluded `apps/dashboard/src/app/lib/` and
# shipped a broken build to CI, because the source file existed locally but was
# never committed. Only keep a pattern unanchored when the name is unambiguously
# build output.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
.eggs/
sdist/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
/env/
/ENV/
/downloads/
/eggs/
/lib/
/lib64/
/parts/
/var/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Docker
.docker/

# Agent clients (local overrides only; shared config is committed)
.claude/settings.local.json

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Env files
.env
.env.*
!.env.example

# Protobuf / generated
**/generated/

# MkDocs build output (`task docs:build` writes here; site_dir in mkdocs.yml)
/site/
