# Quantified Self Platform — Environment Configuration Template
# Copy this file to .env or use defaults for local development.

# ─── Security & Authentication ──────────────────────────────
# JWT Secret shared between API Gateway and Core Data Service.
# In development, defaults to 'dev-secret-key-quantified-self-2026'.
# For production, generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-key-quantified-self-2026
JWT_ALGORITHM=HS256

# Symmetric Encryption Key (Fernet AES-256) for connector credentials at rest.
# For production, generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=dev-encryption-key-quantified-self-2026

# ─── Environment & CORS ─────────────────────────────────────
ENVIRONMENT=dev
ALLOWED_ORIGINS=http://localhost:3000

# ─── Core Data Service ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://qs_dev:qs_dev_password@127.0.0.1:5433/quantified_self
DATABASE_SSL=false
NATS_URL=nats://127.0.0.1:4222
GRPC_PORT=50051

# ─── Microservice URLs ──────────────────────────────────────
CORE_SERVICE_URL=http://127.0.0.1:8001
ANALYSIS_SERVICE_URL=http://127.0.0.1:8002

# ─── Dashboard (Next.js 15) ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
