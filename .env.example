# Quantified Self Platform — Environment Configuration Template
# Copy this file to .env or use defaults for local development.

# ─── Security & Authentication ──────────────────────────────
# The three secrets below are DEVELOPMENT values and are printed in this file, in
# git, and in the source. They are fine for `docker compose up` on a laptop and
# are not secrets anywhere else.
#
# Nothing here needs to be edited for production, because production does not
# read this file: docker-compose.prod.yml requires the variables to be set in
# the environment and refuses to start without them. Core and the Gateway also
# refuse to serve when ENVIRONMENT is production-like and a value matches one of
# these. Generate real ones with:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"

# Shared between API Gateway and Core Data Service.
JWT_SECRET=dev-secret-key-quantified-self-2026
JWT_ALGORITHM=HS256

# Signs internal service credentials. Deliberately separate from JWT_SECRET so a
# compromised importer cannot mint user tokens. Must be identical on Core and
# every importer. Empty derives a deterministic value from JWT_SECRET.
INTERNAL_SERVICE_SECRET=

# Fernet AES-256 key for connector credentials at rest.
#
# This one is not interchangeable with the others: it decrypts data already in
# the database. Changing it without re-encrypting first makes every stored
# connector token permanently unreadable. If you need to change it, run
# `python -m core.rotate_encryption_key --old … --new …` first — see
# docs/operations.md.
ENCRYPTION_KEY=dev-encryption-key-quantified-self-2026

# ─── Environment & CORS ─────────────────────────────────────
# Anything other than production/prod/staging keeps the secret check a warning.
ENVIRONMENT=dev
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:3000

# ─── Core Data Service ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://qs_dev:qs_dev_password@127.0.0.1:5433/quantified_self
DATABASE_SSL=false
NATS_URL=nats://127.0.0.1:4222
GRPC_PORT=50051

# ─── Microservice URLs ──────────────────────────────────────
CORE_SERVICE_URL=http://127.0.0.1:8001
# 8010 is the port the Analysis service binds. This said 8002, so every
# /api/v1/analysis call from a local checkout went to a closed port.
ANALYSIS_SERVICE_URL=http://127.0.0.1:8010

# ─── Dashboard (Next.js 16) ─────────────────────────────────
# Deliberately unset, and left commented out.
#
# The UI calls its own origin: in production Traefik owns that origin and routes
# /api to the Gateway, and `next dev` rewrites /api to the Gateway itself (see
# next.config.ts). Nothing has to be configured for either.
#
# Set it only for the case that does not fit -- a UI served from a different
# origin than its API -- and note that it is read at BUILD time: Next inlines
# NEXT_PUBLIC_* into the client bundle, so setting it on a running container does
# nothing. For an image you build yourself it is a build argument; see
# docs/deployment.md. Setting it here to a *different host* than the one you open
# in the browser (127.0.0.1 against localhost) also costs you the session:
# cookies are not shared between them.
# NEXT_PUBLIC_API_URL=https://api.example.com

# ─── Production deployment (docker-compose.prod.yml) ────────
# Which published release to run, and where to pull it from. Only used by the
# production stack; the dev stack in infra/ builds from source. Pin a version for
# anything that has to be roll-back-able -- `latest` moves with every release.
QS_VERSION=latest
QS_IMAGE_PREFIX=ghcr.io/iamtim0/quantified-self

# Host ports of the production stack. Only QS_HTTP_PORT has to be public; the
# Traefik dashboard is bound to loopback regardless.
# QS_HTTP_PORT=80
# QS_GATEWAY_PORT=8000
# QS_APPLE_HEALTH_PORT=8005
# QS_STREAK_PORT=8006
# QS_TRAEFIK_DASHBOARD_PORT=8081

# Set once, when the postgres volume is first initialised. Changing it later does
# not change the password in the database -- see docs/deployment.md.
# POSTGRES_PASSWORD=qs_dev_password

# ─── Cloudflare Tunnel ──────────────────────────────────────
# Optional: a token for a persistent Named Cloudflare Tunnel.
#
# The cloudflared service starts by default in production. If you don't use
# Cloudflare, leave this empty, but remember to set QS_BIND_IP=0.0.0.0 so
# that Traefik binds to the public interface instead of localhost.
#
# If you do use the Cloudflare Tunnel (recommended for Coolify deployments),
# configure its published application to use http://traefik:80 -- not localhost
# or a host port. The token is read from this variable, never a command flag.
TUNNEL_TOKEN=

# ─── Sign-in throttle: how many proxies are in front ─────────
# Failed sign-ins are counted per account and per client address. This decides
# which entry of `X-Forwarded-For` counts as the client, taken from the RIGHT —
# the left of that header is whatever the caller typed, so a limit keyed on it
# would be bypassed by sending a header.
#
#   0  nothing in front; the socket peer is used and cannot be forged
#   1  Traefik only — the default, and correct for the bare production stack
#   2  something in front of Traefik: a Cloudflare Tunnel, a platform ingress
#
# **Set this to 2 if TUNNEL_TOKEN above is set.** cloudflared is a second hop,
# so with the default of 1 every request looks like cloudflared's own address
# and all of them share a single throttle bucket. Nothing breaks and nothing
# warns — the per-client limit just stops distinguishing between callers, and
# a busy workspace could throttle itself. The per-account limit is unaffected
# either way; it does not depend on the network at all.
#
# See docs/features/authentication.md#which-address-counts-as-the-client.
# TRUSTED_PROXY_HOPS=1
