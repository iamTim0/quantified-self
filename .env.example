# Quantified Self Platform — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.

# ─── Core Data Service ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://qs_dev:CHANGE_ME@127.0.0.1:5433/quantified_self
DATABASE_SSL=false
NATS_URL=nats://127.0.0.1:4222

# ─── Encryption (Fernet AES-256) ─────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_KEY

# ─── API Gateway ─────────────────────────────────────────────
ENVIRONMENT=dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
CORE_SERVICE_URL=http://127.0.0.1:8001
ALLOWED_ORIGINS=http://localhost:3000

# ─── Oura Importer ───────────────────────────────────────────
OURA_ACCESS_TOKEN=
TENANT_ID=00000000-0000-0000-0000-000000000001
SOURCE_ID=00000000-0000-0000-0000-000000000002
POLL_INTERVAL_SECONDS=3600
POLL_LOOKBACK_DAYS=7

# ─── Dashboard (Next.js) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
