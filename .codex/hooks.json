{
  "description": "Quantified Self repository safety and documentation hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|shell_command|run_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/scripts/pre_command_guard.py",
            "timeout": 10,
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/scripts/validate_docs.py",
            "timeout": 15,
            "statusMessage": "Validating documentation"
          }
        ]
      }
    ]
  }
}
