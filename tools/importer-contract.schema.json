{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/quantified-self-importer-contract.schema.json",
  "title": "Quantified Self importer contract",
  "type": "object",
  "required": [
    "$schema",
    "contract_version",
    "source_type",
    "ingest_subject",
    "task_subject",
    "entrypoint",
    "required_modules",
    "communication",
    "ingest_event_fields",
    "input_contracts",
    "metrics",
    "dynamic_namespaces",
    "capabilities"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "contract_version": {"const": 1},
    "source_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "ingest_subject": {"type": "string"},
    "task_subject": {"type": ["string", "null"]},
    "entrypoint": {"type": "string"},
    "required_modules": {"type": "array", "items": {"type": "string"}},
    "communication": {"type": "object"},
    "ingest_event_fields": {"type": "array", "items": {"type": "string"}},
    "input_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "format", "source_of_truth"],
        "properties": {
          "name": {"type": "string"},
          "format": {
            "type": "string",
            "enum": ["json", "xml", "zip_csv", "zip_xml_gpx", "ics", "rest_json"]
          },
          "generated": {"type": "boolean"},
          "generated_from": {"type": "string"},
          "source_of_truth": {
            "type": "object",
            "required": ["kind", "reference"],
            "properties": {
              "kind": {"type": "string"},
              "schema": {"type": "string"},
              "reference": {"type": "string"}
            }
          }
        }
      }
    },
    "metrics": {"type": "array", "items": {"type": "string"}},
    "dynamic_namespaces": {"type": "array", "items": {"type": "string"}},
    "capabilities": {
      "type": "object",
      "required": ["scheduled_sync", "webhook", "file_upload"],
      "properties": {
        "scheduled_sync": {"type": "boolean"},
        "webhook": {"type": "boolean"},
        "file_upload": {"type": "boolean"}
      }
    }
  }
}
